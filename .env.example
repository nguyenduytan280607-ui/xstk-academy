# Copy file này thành .env và thêm API key của riêng bạn.
# Không chia sẻ .env và không đưa API key lên GitHub hoặc vào mã frontend.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini
API_PORT=8787
# Khi deploy, đặt FRONTEND_URL bằng URL Vercel của website (không có dấu / cuối).
FRONTEND_URL=http://localhost:5173
